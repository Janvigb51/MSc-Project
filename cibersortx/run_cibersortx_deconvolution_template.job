#!/bin/bash
#SBATCH --job-name=cibx_deconv
#SBATCH --output=cibersortx/logs/cibx_deconv.%j.out
#SBATCH --error=cibersortx/logs/cibx_deconv.%j.err
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G

set -e

echo "Running on node: $(hostname)"
echo "Started at: $(date)"
echo "Submitted from: $SLURM_SUBMIT_DIR"

start_time=$SECONDS

SINGULARITY="/opt/ohpc/pub/libs/apptainer/1.3.2/bin/singularity"
CONTAINER="/data/containers/fractions_latest.sif"

# Change this to breast or lung
DATASET="breast"

PROJECT_DIR="$SLURM_SUBMIT_DIR"
CIBERSORTX_DIR="$PROJECT_DIR/cibersortx"

input_dir="$CIBERSORTX_DIR/cibersortx_inputs/$DATASET"
signature_dir="$CIBERSORTX_DIR/cibersortx_results/$DATASET"
output_dir="$CIBERSORTX_DIR/cibersortx_results/${DATASET}_deconvolution"

mkdir -p "$output_dir"

sigmatrix_name="CIBERSORTx_sample_file_for_cibersort_inferred_phenoclasses.CIBERSORTx_sample_file_for_cibersort_inferred_refsample.bm.K999.txt"
sourceGEP_name="CIBERSORTx_cell_type_sourceGEP.txt"

# Copy required signature outputs into the mounted input directory
cp "$signature_dir/$sigmatrix_name" "$input_dir/"
cp "$signature_dir/$sourceGEP_name" "$input_dir/"

echo "Dataset: $DATASET"
echo "Input dir: $input_dir"
echo "Signature dir: $signature_dir"
echo "Output dir: $output_dir"
echo "Running CIBERSORTx cell fraction imputation..."

: "${CIBERSORTX_USERNAME:?Please set CIBERSORTX_USERNAME}"
: "${CIBERSORTX_TOKEN:?Please set CIBERSORTX_TOKEN}"

"$SINGULARITY" exec \
  --bind "$input_dir":/src/data \
  --bind "$output_dir":/src/outdir \
  "$CONTAINER" \
  /src/CIBERSORTxFractions \
  --username "$CIBERSORTX_USERNAME" \
  --token "$CIBERSORTX_TOKEN" \
  --refsample /src/data/sample_file_for_cibersort.txt \
  --perm 200 \
  --single_cell TRUE \
  --mixture /src/data/mixture_file_for_cibersort.txt \
  --sourceGEPs /src/data/$sourceGEP_name \
  --sigmatrix /src/data/$sigmatrix_name \
  --fraction 0 \
  --rmbatchSmode TRUE \
  --verbose TRUE

elapsed=$(( SECONDS - start_time ))
echo "Elapsed time: $elapsed seconds"
echo "Finished at: $(date)"
